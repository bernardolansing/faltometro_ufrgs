# The session ID extracted from PHPSESSID cookie in UFRGS student's dashboard. Set this ID if you want to scrap data
# locally during development. In production, this token is provided as an argument through AWS.
UFRGS_SESSION_ID=

# Credentials for a local database to be used during development. When deployed, the database credentials will be
# provided via AWS Secrets Manager.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
