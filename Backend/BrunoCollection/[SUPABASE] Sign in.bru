meta {
  name: [SUPABASE] Sign in
  type: http
  seq: 4
}

post {
  url: https://{{PROJECT_ID}}.supabase.co/auth/v1/token?grant_type=password
  body: json
  auth: inherit
}

params:query {
  grant_type: password
}

headers {
  apikey: {{PUBLIC_API_KEY}}
}

body:json {
  {
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
